        row('Tipo Cédula', payload.tipo || '') +
        row('Cédula', payload.cedula || '') +
        row('Correo', payload.correo || '') +
        row('Teléfono', payload.telefono || '-') +
        row('Act. Económica', payload.actividad || '-') +
